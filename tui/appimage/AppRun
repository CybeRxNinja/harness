#!/bin/sh
# Harness AppImage AppRun — first launch sets everything up, later launches just run.
# Delegates setup to the harness CLI (single implementation, tested), then execs the TUI.
set -u
PORT="${HARNESS_PORT:-8787}"
HARNESS_DIR="$HOME/.harness"

log() { echo "[harness] $*" >&2; }

# --- 1. harness CLI (installed once, refreshed when the contract moves) ---
# AppRun depends on current CLI behavior (per-directory serve, AppImage lookup,
# setup-only). Reinstall whenever the installed copy is missing or too old.
NEED_PROTO=5
cli_ok() { python3 -c "from harness import PROTO; raise SystemExit(0 if PROTO >= $NEED_PROTO else 1)" 2>/dev/null; }
if ! cli_ok; then
  log "installing harness CLI from GitHub (once)..."
  if ! python3 -m pip install --no-cache-dir --break-system-packages "git+https://github.com/CybeRxNinja/harness.git" 2>&1 | tail -3 >&2; then
    log "retrying without break-system-packages..."
    python3 -m pip install --no-cache-dir "git+https://github.com/CybeRxNinja/harness.git" 2>&1 | tail -3 >&2
  fi
  cli_ok || { log "FATAL: harness CLI install failed — check network/pip, then relaunch"; exit 1; }
fi

# --- 2. gateway + config + token (rooted at the directory you launched from) ---
if cli_ok; then
  # shellcheck disable=SC1090
  eval "$(python3 -m harness --root "$PWD" tui --setup-only --port "$PORT" 2>/dev/null)" || log "gateway setup had issues — continuing"
else
  HARNESS_URL="${HARNESS_URL:-http://127.0.0.1:$PORT}"; export HARNESS_URL
  if [ -f "$HARNESS_DIR/token" ]; then
    HARNESS_TOKEN="$(cat "$HARNESS_DIR/token")"; export HARNESS_TOKEN
  fi
fi

# --- 3. launcher shortcut ---
DESKTOP="$HOME/.local/share/applications/harness-tui.desktop"
if [ -n "${APPIMAGE:-}" ] && [ ! -f "$DESKTOP" ]; then
  mkdir -p "$(dirname "$DESKTOP")" "$HOME/.local/share/icons"
  [ -f "$APPDIR/harness-tui.png" ] && cp -f "$APPDIR/harness-tui.png" "$HOME/.local/share/icons/" 2>/dev/null
  cat > "$DESKTOP" <<EOF
[Desktop Entry]
Name=Harness TUI
Comment=All-in-one AI coding harness
Exec="$APPIMAGE"
Icon=harness-tui
Type=Application
Categories=Development;Utility;
Terminal=true
EOF
  log "launcher shortcut installed"
fi

# --- 4. run ---
exec "$APPDIR/usr/bin/harness-tui" "$@"
