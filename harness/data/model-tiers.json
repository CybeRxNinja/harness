{
  "tiers": ["cheap", "mid", "strong"],
  "notes": "First matching pattern wins. Patterns match the full provider/model id, lowercase. These are fallbacks: models.dev cost data decides free/paid and, when no pattern matches, the tier (<=1 $/M input cheap, <=5 mid, else strong). `exclude` removes models that are not coding workers at all (audio/image/embedding, or routers that pick a model themselves).",
  "exclude": [
    "*lyria*", "*tts*", "*whisper*", "*embed*", "*rerank*", "*moderation*",
    "*content-safety*", "*image*", "*diffusion*", "*sdxl*", "*flux*",
    "*/auto", "*kilo-auto*"
  ],
  "patterns": [
    { "match": "*-free", "tier": "cheap", "free": true },
    { "match": "*claude-opus*", "tier": "strong", "strengths": ["reasoning", "review", "security"] },
    { "match": "*gpt-5*pro*", "tier": "strong" },
    { "match": "*gpt-5*codex*", "tier": "strong" },
    { "match": "*o3*", "tier": "strong" },
    { "match": "*o4*", "tier": "strong" },
    { "match": "*deepseek*flash*", "tier": "cheap", "strengths": ["code", "recon"] },
    { "match": "*claude-haiku*", "tier": "cheap", "strengths": ["fast", "recon"] },
    { "match": "*gpt-*mini*", "tier": "cheap", "strengths": ["fast", "recon"] },
    { "match": "*nano*", "tier": "cheap", "strengths": ["fast", "recon"] },
    { "match": "*lite*", "tier": "cheap", "strengths": ["fast", "recon"] },
    { "match": "*gemini*flash*", "tier": "cheap" },
    { "match": "*glm*flash*", "tier": "cheap" },
    { "match": "*qwen*flash*", "tier": "cheap" },
    { "match": "*nemotron*lightning*", "tier": "cheap" },
    { "match": "*mimo*flash*", "tier": "cheap" },
    { "match": "*deepseek*pro*", "tier": "mid", "strengths": ["code", "reasoning"] },
    { "match": "*claude-sonnet*", "tier": "mid", "strengths": ["code", "review"] },
    { "match": "*gemini*pro*", "tier": "mid" },
    { "match": "*gpt-5*", "tier": "mid", "strengths": ["code", "reasoning"] },
    { "match": "*kimi*", "tier": "mid" },
    { "match": "*grok*", "tier": "mid" }
  ]
}
